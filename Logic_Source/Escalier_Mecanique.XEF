	<program>
		<identProgram name="LOGIC_MOTEUR" type="section" task="MAST" SectionOrder="5"></identProgram>
		<STSource>(* ===================================================== *)
(*  LOGIC_MOTEUR - Clean &amp; Stable Version               *)
(* ===================================================== *)

(* Main Motor Control *)
IF Presence_Confirmed AND BPM AND NOT BPA THEN
    KM1 := TRUE;
    KM2 := TRUE;
    H_RUN := TRUE;
    H_IDLE := FALSE;
ELSE
    KM1 := FALSE;
    KM2 := FALSE;
    H_RUN := FALSE;
    H_IDLE := TRUE;
END_IF;

(* Safety - Highest Priority *)
IF BPA OR H_FLT THEN
    KM1 := FALSE;
    KM2 := FALSE;
    H_RUN := FALSE;
    H_IDLE := FALSE;
    H_FLT := TRUE;
ELSE
    H_FLT := FALSE;
END_IF;

(* Force H_IDLE when system is stopped *)
IF NOT KM1 AND NOT KM2 THEN
    H_IDLE := TRUE;
END_IF;
</STSource>
	</program>
